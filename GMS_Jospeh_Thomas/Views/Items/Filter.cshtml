@using GMS_Jospeh_Thomas.Models
@model IEnumerable<Item>

@{
    ViewData["Title"] = "Filter by Category";
    var selected = ViewBag.SelectedCategory as string;
    var categories = Html.GetEnumSelectList<ItemCategory>()
        .Select(c => new SelectListItem { Text = c.Text, Value = c.Value, Selected = c.Text == selected });
}

<h1>Filter by Category</h1>

<form asp-action="Filter" method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <select name="category" class="form-select" asp-items="categories">
            <option value="">-- Select a category --</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (ViewBag.Searched == true)
{
    if (!Model.Any())
    {
        <p>No items found in the <strong>@selected</strong> category.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.PurchaseDate)</th>
                    <th>@Html.DisplayNameFor(model => model.Price)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.PurchaseDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.Price)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<a asp-controller="Home" asp-action="Index">Back to Home</a>